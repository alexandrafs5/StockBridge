# Connection string de Supabase (Settings > Database > Connection string > Prisma)
DATABASE_URL="postgresql://user:password@host:5432/postgres?pgbouncer=true"

# Puerto en el que corre el API localmente
PORT=3000

# Token fijo que el cliente MAUI debe mandar como "Authorization: Bearer <token>"
API_TOKEN="cambia-esto-por-un-token-largo-y-random"
