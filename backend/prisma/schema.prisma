generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Producto {
  id        String   @id @default(uuid())
  sku       String   @unique
  nombre    String
  precio    Decimal  @db.Decimal(10, 2)
  stock     Int      @default(0)
  deleted   Boolean  @default(false)
  updatedAt DateTime @map("updated_at")
  deviceId  String   @map("device_id")

  detalles DetalleVenta[]

  @@map("productos")
}

// Encabezado de una venta — lo que en la tienda sería "el ticket".
// Agrupa una o varias líneas (DetalleVenta), cada una un producto distinto.
model VentaTicket {
  id             String   @id @default(uuid())
  metodoPago     String   @default("efectivo") @map("metodo_pago") // "efectivo" | "transferencia" | "tarjeta"
  total          Decimal  @db.Decimal(10, 2)
  vendedorId     String?  @map("vendedor_id")
  vendedorNombre String?  @map("vendedor_nombre") // desnormalizado: se guarda tal cual aunque después cambie/se borre el usuario
  fecha          DateTime @default(now())
  updatedAt      DateTime @map("updated_at")
  deviceId       String   @map("device_id")

  detalles DetalleVenta[]

  @@map("venta_tickets")
}

// Una línea dentro de un ticket: un producto + cantidad + su subtotal.
model DetalleVenta {
  id             String   @id @default(uuid())
  ventaTicketId  String   @map("venta_ticket_id")
  productoId     String   @map("producto_id")
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2) @map("precio_unitario")
  subtotal       Decimal  @db.Decimal(10, 2)
  updatedAt      DateTime @map("updated_at")
  deviceId       String   @map("device_id")

  ventaTicket VentaTicket @relation(fields: [ventaTicketId], references: [id])
  producto    Producto    @relation(fields: [productoId], references: [id])

  @@map("detalle_ventas")
}

// Empleado de la tienda con acceso a la app. El PIN se guarda ya hasheado
// (el hash se calcula en el cliente — el servidor nunca ve el PIN en claro).
model Usuario {
  id        String   @id @default(uuid())
  nombre    String
  pinHash   String   @map("pin_hash")
  rol       String   // "cajero" | "gerente" | "dueno"
  deleted   Boolean  @default(false)
  updatedAt DateTime @map("updated_at")
  deviceId  String   @map("device_id")

  @@map("usuarios")
}

// Registro de auditoría de operaciones ya procesadas por el servidor.
// Se usa para garantizar idempotencia: si el cliente reenvía una operación
// (por una conexión que se cayó a medio POST), el servidor la reconoce
// por su id (UUID generado en el cliente) y no la vuelve a aplicar.
model SyncLog {
  id          String   @id // mismo UUID que trae la operación desde sync_queue del cliente
  tabla       String
  operacion   String
  procesadoEn DateTime @default(now()) @map("procesado_en")

  @@map("sync_log")
}
