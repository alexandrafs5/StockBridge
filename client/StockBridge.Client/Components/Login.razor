@using StockBridge.Client.Utils
@inject LocalDatabase Db
@inject SessionService Session
@inject SyncService SyncService
@implements IDisposable

<div class="login-screen">
    <div class="login-card">
        <div class="login-brand">StockBridge</div>

        @if (_cargando)
        {
            <p class="login-hint">Buscando información de la tienda...</p>
        }
        else if (_sinVerificar)
        {
            <h2>Sin conexión</h2>
            <p class="login-hint">
                Este equipo todavía no está configurado y no pudimos consultar el servidor
                para ver si tu tienda ya existe en la nube.
            </p>
            <button class="btn-primary" @onclick="Reintentar">Reintentar</button>
            <button class="btn-link" @onclick="ConfigurarSinConexion">
                Es la primera computadora de la tienda: configurar sin conexión
            </button>
        }
        else if (_esNegocioNuevo)
        {
            <h2>Configuración inicial</h2>
            <p class="login-hint">Crea tu primera sucursal y la cuenta del dueño. Desde ahí podrás agregar más sucursales y empleados.</p>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="form-message error">@_error</div>
            }

            <div class="field">
                <label for="setup-sucursal">Nombre de la sucursal</label>
                <input id="setup-sucursal" placeholder="Ej. Sucursal Centro" @bind="_nuevaSucursalNombre" />
            </div>
            <div class="field">
                <label for="setup-nombre">Tu nombre (dueño)</label>
                <input id="setup-nombre" @bind="_nombre" />
            </div>
            <div class="field">
                <label for="setup-pin">PIN (4 dígitos)</label>
                <input id="setup-pin" class="mono" type="password" maxlength="4" inputmode="numeric" @bind="_pin" />
            </div>
            <div class="field">
                <label for="setup-pin2">Confirmar PIN</label>
                <input id="setup-pin2" class="mono" type="password" maxlength="4" inputmode="numeric" @bind="_pinConfirmar" />
            </div>
            <button class="btn-primary" @onclick="CrearNegocioInicial">Crear tienda y cuenta de dueño</button>
        }
        else if (_necesitaElegirSucursal)
        {
            <h2>¿En qué sucursal está este equipo?</h2>
            <p class="login-hint">Esta computadora quedará fija a la sucursal que elijas.</p>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="form-message error">@_error</div>
            }

            <div class="login-users">
                @foreach (var s in _sucursales)
                {
                    <button class="login-user" @onclick="() => ElegirSucursal(s)">
                        <span>@s.Nombre</span>
                    </button>
                }
            </div>

            @if (!_agregandoSucursal)
            {
                <button class="btn-link" @onclick="() => _agregandoSucursal = true">+ Agregar sucursal nueva</button>
            }
            else
            {
                <div class="field" style="margin-top:14px">
                    <label for="nueva-sucursal">Nombre de la sucursal nueva</label>
                    <input id="nueva-sucursal" placeholder="Ej. Sucursal Norte" @bind="_nuevaSucursalNombre" />
                </div>
                <button class="btn-primary" @onclick="CrearYElegirSucursal">Crear y usar esta sucursal</button>
                <button class="btn-link" @onclick="() => _agregandoSucursal = false">Cancelar</button>
            }
        }
        else if (!_hayUsuarios && _sinVerificarUsuarios)
        {
            <h2>Sin conexión</h2>
            <p class="login-hint">
                Todavía no hay usuarios en este equipo y no pudimos consultar el servidor.
            </p>
            <button class="btn-primary" @onclick="Reintentar">Reintentar</button>
        }
        else if (_usuarioElegido == null)
        {
            <h2>¿Quién eres?</h2>
            <div class="login-users">
                @foreach (var u in _usuarios)
                {
                    <button class="login-user" @onclick="() => Elegir(u)">
                        <span>@u.Nombre</span>
                        <span class="role-badge role-@u.Rol">@EtiquetaRol(u.Rol)</span>
                    </button>
                }
            </div>
        }
        else
        {
            <h2>Hola, @_usuarioElegido.Nombre</h2>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="form-message error">@_error</div>
            }

            <div class="field">
                <label for="login-pin">PIN</label>
                <input id="login-pin" class="mono" type="password" maxlength="4" inputmode="numeric"
                       @bind="_pin" @onkeydown="OnPinKeyDown" />
            </div>
            <button class="btn-primary" @onclick="Entrar">Entrar</button>
            <button class="btn-link" @onclick="Volver">← Cambiar de usuario</button>
        }
    </div>
</div>

@code {
    private bool _cargando = true;
    private bool _sinVerificar; // no se pudo determinar si el negocio ya existe (sin conexión, primera vez)

    // Etapa 1: sucursal del dispositivo (solo si DispositivoConfig.SucursalId es null)
    private bool _esNegocioNuevo;
    private bool _necesitaElegirSucursal;
    private List<Sucursal> _sucursales = new();
    private bool _agregandoSucursal;
    private string _nuevaSucursalNombre = string.Empty;

    // Etapa 2: login de usuario (igual que antes)
    private bool _hayUsuarios;
    private bool _sinVerificarUsuarios;
    private List<Usuario> _usuarios = new();
    private Usuario? _usuarioElegido;

    private string _nombre = string.Empty;
    private string _pin = string.Empty;
    private string _pinConfirmar = string.Empty;
    private string _error = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        SyncService.EstadoCambiado += OnEstadoSync;
        await Cargar();
    }

    private async Task Cargar()
    {
        _cargando = true;
        _sinVerificar = false;
        _error = string.Empty;

        if (DispositivoConfig.SucursalId == null)
        {
            // Bootstrap: sin sucursal asignada, el pull solo trae sucursales + dueños.
            var sincronizo = await SyncService.SincronizarAsync();
            var sucursales = await Db.ObtenerSucursalesAsync();
            var usuariosVisibles = await Db.ObtenerUsuariosAsync(); // ya incluye dueños sin importar sucursal
            var hayDueno = usuariosVisibles.Any(u => u.Rol == Roles.Dueno);

            if (sucursales.Count == 0 && !hayDueno)
            {
                if (!sincronizo)
                {
                    _sinVerificar = true;
                    _cargando = false;
                    return;
                }
                _esNegocioNuevo = true;
            }
            else
            {
                _necesitaElegirSucursal = true;
                _sucursales = sucursales;
            }

            _cargando = false;
            return;
        }

        // Ya tiene sucursal asignada: flujo normal de login.
        _esNegocioNuevo = false;
        _necesitaElegirSucursal = false;
        _hayUsuarios = await Db.ExisteAlgunUsuarioAsync();
        _sinVerificarUsuarios = false;

        if (!_hayUsuarios)
        {
            var sincronizo = await SyncService.SincronizarAsync();
            _hayUsuarios = await Db.ExisteAlgunUsuarioAsync();
            _sinVerificarUsuarios = !_hayUsuarios && !sincronizo;
        }

        _usuarios = await Db.ObtenerUsuariosAsync();
        _cargando = false;
    }

    // Si una sincronización termina mientras se ve el login, se refresca sin perder lo que se esté haciendo.
    private void OnEstadoSync(object? sender, string estado)
    {
        if (estado != "Al día") return;

        InvokeAsync(async () =>
        {
            if (_cargando || _usuarioElegido != null || _necesitaElegirSucursal || _esNegocioNuevo) return;

            _hayUsuarios = await Db.ExisteAlgunUsuarioAsync();
            _usuarios = await Db.ObtenerUsuariosAsync();
            if (_hayUsuarios) _sinVerificarUsuarios = false;
            StateHasChanged();
        });
    }

    private async Task Reintentar() => await Cargar();

    private void ConfigurarSinConexion()
    {
        _sinVerificar = false;
        _esNegocioNuevo = true;
    }

    private static string EtiquetaRol(string rol) => rol switch
    {
        Roles.Dueno => "Dueño",
        Roles.Gerente => "Gerente",
        _ => "Cajero"
    };

    private static bool PinValido(string pin) =>
        pin.Length == 4 && pin.All(char.IsDigit);

    private async Task CrearNegocioInicial()
    {
        if (string.IsNullOrWhiteSpace(_nuevaSucursalNombre))
        {
            _error = "Escribe el nombre de la sucursal.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_nombre))
        {
            _error = "Escribe tu nombre.";
            return;
        }
        if (!PinValido(_pin))
        {
            _error = "El PIN debe ser de exactamente 4 dígitos.";
            return;
        }
        if (_pin != _pinConfirmar)
        {
            _error = "Los PINs no coinciden.";
            return;
        }

        var sucursal = await Db.CrearSucursalAsync(_nuevaSucursalNombre, null);
        DispositivoConfig.SucursalId = sucursal.Id;

        var dueno = await Db.CrearUsuarioAsync(_nombre, _pin, Roles.Dueno, null);
        _error = string.Empty;
        Session.IniciarSesion(dueno);
    }

    private async Task ElegirSucursal(Sucursal s)
    {
        DispositivoConfig.SucursalId = s.Id;
        SyncService.ForzarResincronizacionCompleta();
        await Cargar();
    }

    private async Task CrearYElegirSucursal()
    {
        if (string.IsNullOrWhiteSpace(_nuevaSucursalNombre))
        {
            _error = "Escribe el nombre de la sucursal.";
            return;
        }

        var sucursal = await Db.CrearSucursalAsync(_nuevaSucursalNombre, null);
        _nuevaSucursalNombre = string.Empty;
        _agregandoSucursal = false;
        await ElegirSucursal(sucursal);
    }

    private void Elegir(Usuario u)
    {
        _usuarioElegido = u;
        _pin = string.Empty;
        _error = string.Empty;
    }

    private void Volver()
    {
        _usuarioElegido = null;
        _pin = string.Empty;
        _error = string.Empty;
    }

    private async Task OnPinKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Entrar();
    }

    private async Task Entrar()
    {
        if (_usuarioElegido == null) return;

        var usuario = await Db.VerificarLoginAsync(_usuarioElegido.Id, _pin);
        if (usuario == null)
        {
            _error = "PIN incorrecto.";
            _pin = string.Empty;
            return;
        }

        _error = string.Empty;
        _pin = string.Empty;
        Session.IniciarSesion(usuario);
    }

    public void Dispose()
    {
        SyncService.EstadoCambiado -= OnEstadoSync;
    }
}
