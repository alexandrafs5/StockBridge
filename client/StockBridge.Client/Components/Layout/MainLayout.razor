@inherits LayoutComponentBase
@inject SyncService SyncService
@inject SessionService Session
@implements IDisposable

@if (Session.UsuarioActual == null)
{
    <Login />
}
else
{
    <div class="app-shell">
        <aside class="sidebar">
            <div class="sidebar-brand">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                    <path d="M2 14 L8 7 L12 11 L18 4" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="18" cy="4" r="1.6" fill="#fff"/>
                    <circle cx="2" cy="14" r="1.6" fill="#fff"/>
                </svg>
                StockBridge
            </div>
            <nav class="sidebar-nav">
                <NavLink href="/" Match="Microsoft.AspNetCore.Components.Routing.NavLinkMatch.All">Productos</NavLink>
                <NavLink href="/ventas">Ventas</NavLink>
                @if (Session.PuedeGestionarUsuarios)
                {
                    <NavLink href="/usuarios">Usuarios</NavLink>
                }
            </nav>

            <div class="sidebar-user">
                <div class="sidebar-user-nombre">@Session.UsuarioActual.Nombre</div>
                <span class="role-badge role-@Session.UsuarioActual.Rol">@EtiquetaRol(Session.UsuarioActual.Rol)</span>
                <button class="btn-logout" @onclick="Session.CerrarSesion">Cerrar sesión</button>
            </div>
        </aside>

        <div class="main-column">
            <div class="topbar">
                <div class="sync-status">
                    <span class="sync-dot @EstadoClase"></span>
                    @_estado
                </div>
                <button class="btn-sync" @onclick="SincronizarAhora">Sincronizar ahora</button>
            </div>

            <main>
                @Body
            </main>
        </div>
    </div>
}

@code {
    private string _estado = "Sin sincronizar";

    private string EstadoClase => _estado switch
    {
        "Al día" => "ok",
        "Sincronizando..." => "syncing",
        var s when s.Contains("Sin conexión") || s.Contains("No se pudo sincronizar") => "error",
        _ => ""
    };

    private static string EtiquetaRol(string rol) => rol switch
    {
        Roles.Dueno => "Dueño",
        Roles.Gerente => "Gerente",
        _ => "Cajero"
    };

    protected override void OnInitialized()
    {
        SyncService.EstadoCambiado += OnEstadoCambiado;
        Session.SesionCambiada += OnSesionCambiada;
        _ = SyncService.SincronizarAsync(); // intenta sincronizar al abrir la app (también trae usuarios de otros dispositivos)
    }

    private void OnEstadoCambiado(object? sender, string estado)
    {
        _estado = estado;
        InvokeAsync(StateHasChanged);
    }

    private void OnSesionCambiada(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private async Task SincronizarAhora() => await SyncService.SincronizarAsync();

    public void Dispose()
    {
        SyncService.EstadoCambiado -= OnEstadoCambiado;
        Session.SesionCambiada -= OnSesionCambiada;
    }
}
